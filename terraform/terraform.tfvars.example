# Terraform Variables Configuration Examples
# Copy this file to terraform.tfvars and customize for your environment

# ============================================================================
# Basic Configuration
# ============================================================================
project_name = "aiops-mcp-ecs"
region       = "cn-northwest-1"
environment  = "dev"

# VPC Configuration
vpc_cidr = "10.0.0.0/16"

# Logging
log_retention_days = 7

# ============================================================================
# Authentication
# ============================================================================
# Generate a token: openssl rand -base64 32
# When set, all MCP endpoints require Authorization header.
# Supports both "Bearer <token>" and "<token>" formats.
# Leave empty to disable auth (not recommended for production).

# auth_token = "your-secret-token-here"

# ============================================================================
# MCP Services Configuration
# ============================================================================
# Simple enable/disable controls for MCP services
# Set to true to deploy the corresponding MCP server

deploy_aws_api       = true   # AWS CLI command execution and AWS API calls
deploy_aws_doc       = false  # AWS documentation search and reading
deploy_aws_knowledge = false  # AWS knowledge base with advanced search

# Custom fork images (set by build scripts, or override manually)
# Leave empty or remove to use default ECR images
# aws_api_image = "<account-id>.dkr.ecr.cn-northwest-1.amazonaws.com.cn/aws-api-mcp-server:cross-account"
# aws_doc_image = "<account-id>.dkr.ecr.cn-northwest-1.amazonaws.com.cn/aws-documentation-mcp-server-http:latest"

# Each enabled service will automatically get:
# - ECS Service and Task Definition
# - Target Group for load balancing
# - ALB Listener Rules for path-based routing
# - CloudWatch Log Group
# - Proper IAM roles and security groups

# Service Details:
# 
# aws-api (deploy_aws_api=true):
#   - Path: /aws-api/*
#   - Tools: AWS CLI command execution, suggest commands
#   - Use case: Execute AWS operations, manage resources
#
# aws-doc (deploy_aws_doc=true):
#   - Path: /aws-doc/*
#   - Tools: Read documentation, search docs, get recommendations
#   - Use case: Access AWS documentation, search for guides
#   - Partition: aws-cn (China region documentation)
#
# aws-knowledge (deploy_aws_knowledge=true):
#   - Path: /aws-knowledge/*
#   - Tools: Advanced documentation search, regional availability
#   - Use case: Deep AWS knowledge queries, service availability checks

# ============================================================================
# Advanced: Custom MCP Services Configuration (Optional)
# ============================================================================
# For advanced users who need to customize container images, resources, or add custom MCP servers
# When set, this overrides the deploy_* variables above

# Uncomment and customize if needed:
# mcp_services = {
#   aws-api = {
#     enabled        = true
#     image          = "your-ecr-repo/custom-aws-api:latest"  # Custom image
#     cpu            = 1024  # More CPU
#     memory         = 2048  # More memory
#     desired_count  = 2     # High availability
#     container_port = 8000
#     path_pattern   = "/aws-api/*"
#     priority       = 100
#     environment_vars = {
#       AWS_REGION        = "cn-northwest-1"
#       FASTMCP_TRANSPORT = "http"
#       FASTMCP_PORT      = "8000"
#       FASTMCP_HOST      = "0.0.0.0"
#       FASTMCP_LOG_LEVEL = "DEBUG"  # More verbose logging
#       CUSTOM_VAR        = "custom_value"
#     }
#   }
#   
#   custom-mcp = {
#     enabled        = true
#     image          = "your-ecr-repo/custom-mcp-server:latest"
#     cpu            = 512
#     memory         = 1024
#     desired_count  = 1
#     container_port = 3000
#     path_pattern   = "/custom/*"
#     priority       = 400
#     environment_vars = {
#       NODE_ENV  = "production"
#       LOG_LEVEL = "info"
#     }
#   }
# }

# ============================================================================
# Certificate and HTTPS Configuration
# Choose ONE of the scenarios below based on your deployment needs
# ============================================================================

# ----------------------------------------------------------------------------
# Scenario 1: POC/Development (HTTP Only)
# ----------------------------------------------------------------------------
# Use this for quick testing and POC demonstrations
# Access via: http://alb-dns-name.elb.amazonaws.com.cn/aws-api/mcp
# Or use local proxy: socat TCP-LISTEN:3000,fork TCP:alb-dns-name:80

enable_https           = false
certificate_arn        = ""
manage_https_manually  = false
http_to_https_redirect = false

# ----------------------------------------------------------------------------
# Scenario 2: Production (HTTPS with ACM Certificate)
# ----------------------------------------------------------------------------
# Use this when you have a certificate in ACM and want Terraform to manage HTTPS
# Requirements:
# - Certificate must be in ACM in the same region
# - Domain must have valid ICP filing (China regions)
# - DNS must point to ALB
# Access via: https://your-domain.com/aws-api/mcp

# enable_https           = true
# certificate_arn        = "arn:aws-cn:acm:cn-northwest-1:123456789012:certificate/your-cert-id"
# manage_https_manually  = false
# http_to_https_redirect = true  # Redirect all HTTP to HTTPS

# To get your certificate ARN:
# aws acm list-certificates --region cn-northwest-1

# ----------------------------------------------------------------------------
# Scenario 3: Mixed Mode (HTTP + HTTPS)
# ----------------------------------------------------------------------------
# Use this to support both HTTP (for testing) and HTTPS (for production)
# HTTP: http://alb-dns-name.elb.amazonaws.com.cn/aws-api/mcp
# HTTPS: https://your-domain.com/aws-api/mcp

# enable_https           = true
# certificate_arn        = "arn:aws-cn:acm:cn-northwest-1:123456789012:certificate/your-cert-id"
# manage_https_manually  = false
# http_to_https_redirect = false  # Keep both HTTP and HTTPS active

# ----------------------------------------------------------------------------
# Scenario 4: Cross-Account Certificate Management
# ----------------------------------------------------------------------------
# Use this when certificate/domain is managed in another AWS account
# Terraform will create HTTP listener only
# You manually configure HTTPS listener in AWS Console

# enable_https           = true
# certificate_arn        = ""  # Leave empty
# manage_https_manually  = true
# http_to_https_redirect = false

# Manual steps after terraform apply:
# 1. Go to AWS Console -> EC2 -> Load Balancers
# 2. Select your ALB
# 3. Add HTTPS listener (port 443)
# 4. Configure certificate from another account
# 5. Add listener rules for path-based routing

# ============================================================================
# Advanced HTTPS Configuration
# ============================================================================

# SSL/TLS Policy (only applies when enable_https=true)
# Recommended: ELBSecurityPolicy-TLS13-1-2-Res-PQ-2025-09 (most secure)
# ssl_policy = "ELBSecurityPolicy-TLS13-1-2-Res-PQ-2025-09"

# Other options:
# ssl_policy = "ELBSecurityPolicy-TLS13-1-2-2021-06"  # TLS 1.3 and 1.2
# ssl_policy = "ELBSecurityPolicy-2016-08"            # Backward compatibility

# ============================================================================
# China Region Specific Notes
# ============================================================================
# 
# ICP Filing Requirements:
# - All domains used with HTTPS in China regions MUST have valid ICP filing (备案)
# - Certificate domain must match ICP filed domain
# - ICP filing is managed outside AWS (through MIIT)
# 
# Certificate Options:
# 1. ACM Certificate: Request or import certificate in ACM
# 2. Imported Certificate: Import from Let's Encrypt, commercial CA, etc.
# 3. Cross-Account: Use certificate from another AWS account
# 
# DNS Configuration:
# - Point your domain to ALB DNS name using CNAME or ALIAS record
# - ALB DNS format: xxx.cn-northwest-1.elb.amazonaws.com.cn
# - If using Route53 in another account, coordinate with DNS team
# 
# ============================================================================
